# Handoff backend environment variables.
# Copy this file to `.env` (in the backend/ directory) and fill in your own
# values. Never commit a real .env - it is git-ignored.

# --- AI extraction (Gemini) ---

# Required. Your Google Gemini API key.
GEMINI_API_KEY=your-api-key-here

# Optional. The Gemini model to use. Defaults to "gemini-2.0-flash" if unset.
GEMINI_MODEL=gemini-flash-lite-latest

# Optional. Request timeout in seconds. Defaults to 30.0 if unset.
GEMINI_TIMEOUT_SECONDS=30.0